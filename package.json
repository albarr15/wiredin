{
  "name": "wiredin",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "client",
    "server"
  ],
  "scripts": {
    "build:types": "npm run build --workspace=@wiredin/types",
    "build": "npm run build:types && npm run build --workspace=@wiredin/client",
    "dev:client": "npm run dev --workspace=@wiredin/client",
    "dev:server": "npm run start --workspace=@wiredin/server"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
